{
  "name": "redcrayon-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run src/parity.db.test.ts",
    "test:worker": "vitest run src/worker.db.test.ts",
    "gen": "node scripts/gen.mjs",
    "build": "wrangler deploy --dry-run --env '' --outdir dist",
    "surface": "pnpm run build && node scripts/hygiene.mjs && node scripts/surface.mjs > dist/surface.txt",
    "dev": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jose": "6.2.13",
    "typescript": "~5.6.3",
    "vitest": "^4.1.11",
    "wrangler": "4.154.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "body-parser": "^2.4.0",
      "undici@7": "^7.30.1",
      "zod": "^4.6.6"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.5"
  },
  "license": "Apache-2.0"
}
