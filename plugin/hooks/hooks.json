{
  "description": "Fills in redcrayon captures before code-ref calls, records each session's base and cited files after them, and connects a started board chat to the session.",
  "hooks": {
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --wait'",
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --wait'",
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_draw_)?(?:draw|redcrayon)(-dev)?__(start_session|add_code_ref|mark_checkpoint|create_edge|arrive|apply_board)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" hook'",
            "timeout": 45
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_draw_)?(?:draw|redcrayon)(-dev)?__(start_session|add_code_ref|mark_checkpoint|create_edge|arrive|apply_board)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" hook'",
            "timeout": 45
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_draw_)?(?:draw|redcrayon)(-dev)?__(start_session|start_chat)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --start'",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --wait'",
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --resume'",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "sh -c 'exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook --wait'",
            "asyncRewake": true,
            "timeout": 43200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'set -- \"$HOME\"/.redcrayon/chat/*.sock; [ -e \"$1\" ] || exit 0; exec \"${CLAUDE_PLUGIN_ROOT}/bin/draw\" chat-hook'",
            "timeout": 125
          }
        ]
      }
    ]
  }
}
