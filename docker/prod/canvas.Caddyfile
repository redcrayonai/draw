# The canvas image's static server. TLS and routing are the front proxy's
# (compose.prod.yml); this only serves files.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /tmp/site
	encode zstd gzip
	# Vite's hashed output never changes under one name; the shell must revalidate.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	@embed path /embed /embed.html
	header @embed {
		Content-Security-Policy "frame-ancestors *; base-uri 'self'; object-src 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Cache-Control "no-store"
	}
	@embedAlias path /embed
	rewrite @embedAlias /embed.html
	# A single-page app: unknown paths get index.html.
	try_files {path} /index.html
	file_server
}
