{
  "name": "redcrayon-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "db:new": "dbmate new",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/dbmate/dist/cli.js --no-dump-schema up"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "jose": "6.2.12",
    "postgres": "^3.4.9",
    "spacetimedb": "2.10.*"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "dbmate": "^2.36.0",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.6.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^4"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "cookie": "^0.7.0",
      "sharp": "^0.35.5",
      "undici@7": "^7.30.1",
      "undici@8": "^8.12.2"
    },
    "ignoredBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "license": "Apache-2.0"
}
