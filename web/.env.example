# Copy to .env.local (gitignored) and fill in. scripts/dev-dashboard.sh writes a
# working web/.env.local for local dev.

# ── Browser (VITE_*: inlined into the public bundle) ─────────────────────────
# SpacetimeDB WebSocket URL and database (required). Locally use a separate
# database such as redcrayon-dash, never the shared `redcrayon` one.
# ?db=<name> in the page URL overrides the database (see VITE_SPACETIME_DB_ALLOWED).
VITE_SPACETIME_URI=ws://localhost:3000
VITE_SPACETIME_DB=redcrayon-dash
# Databases ?db=<name> may switch to, comma separated. Unset = ?db= is ignored.
# Keep it unset in production builds. Add the agent's database here when it
# differs from VITE_SPACETIME_DB, or the dashboard refuses its link_dashboard
# links. Not `redcrayon`: links leave the default database unnamed, so point
# the agent at this dashboard's database instead (web/README.md).
# VITE_SPACETIME_DB_ALLOWED=
# Canvas base URL for "Open in canvas" links (default http://localhost:5173).
VITE_CANVAS_URL=http://localhost:5173
# Sign-in: anonymous (the default), oidc, or a provider module path (web/README.md).
# VITE_AUTH_PROVIDER=
# For oidc: the issuer and a public PKCE client id.
# VITE_OIDC_ISSUER=
# VITE_OIDC_CLIENT_ID=
# Set to 1 to hard-gate the dashboard behind sign-in.
VITE_REQUIRE_AUTH=
# Hosted privacy policy, linked under the code setting. Unset = no link.
VITE_PRIVACY_URL=
# Hosted agent server for the agent setup page, e.g. https://mcp.example.com/mcp.
# Unset = the page says hosted agents are not available yet.
# VITE_MCP_URL=

# ── Server (/api/* routes, read via $env/dynamic/private) ────────────────────
# Dev only. Production sets these as Worker runtime secrets, never as Build
# variables, and they must never get a VITE_ prefix (that ships them to the
# browser). A route whose values are missing answers 503 instead of failing.
# Postgres: `scripts/pg.sh start` prints this; `pnpm db:migrate` creates the db.
DATABASE_URL=postgres://postgres@localhost:5432/redcrayon?sslmode=disable
# SpacetimeDB HTTP base URL and database (the same database as VITE_SPACETIME_DB;
# /api/activity refuses ?db= values other than this one).
SPACETIMEDB_URL=http://localhost:3000
SPACETIMEDB_DB=redcrayon-dash
# Service token from `curl -X POST http://localhost:3000/v1/identity`. The
# database owner must insert its identity into service_account.
SPACETIMEDB_SERVICE_TOKEN=
# Repository imports run in a separate Node/Go service. These remain server-only.
# Runner base URL (the dashboard appends /imports) and shared request/callback secret.
IMPORT_RUNNER_URL=http://localhost:3101
IMPORT_RUNNER_SECRET=
# Set the identical callback URL on the runner. It must reach this dashboard.
IMPORT_CALLBACK_URL=http://localhost:5174/api/imports/complete
# Who may import: the issuer of the dashboard's session tokens, byte for byte as
# their iss (the same value as VITE_OIDC_ISSUER). Unset = no accounts, and nobody
# may import unless IMPORTS_ANONYMOUS=1 (then any database token may: anyone can
# get one). Authorized parties: optional azp values, comma separated.
# OIDC_ISSUER=
# OIDC_AUTHORIZED_PARTIES=http://localhost:5174
# IMPORTS_ANONYMOUS=1
