VITE_SPACETIME_URI=ws://localhost:3000
VITE_SPACETIME_DB=redcrayon
# Databases ?db=<name> may switch to, comma separated. Unset = ?db= is ignored.
# Keep it unset in production builds.
# VITE_SPACETIME_DB_ALLOWED=
# Sign-in. anonymous (the default) = guests only. oidc = your OpenID Connect
# provider, with a public client (PKCE, no secret) whose redirect URI is this
# origin with a trailing slash; the board still loads anonymously, with an
# optional "sign in" in the header. Or the path, from client/, of a module
# with the same exports.
# VITE_AUTH_PROVIDER=oidc
# oidc only: the issuer exactly as its tokens' iss, and the client id.
# VITE_OIDC_ISSUER=
# VITE_OIDC_CLIENT_ID=
# Hard-gate the whole app behind sign-in (also makes a build without sign-in
# fail loud at startup instead of silently shipping ungated).
# VITE_REQUIRE_AUTH=1
# Dashboard origin for the canvas's "Boards" link back (the dashboard dev
# server is http://localhost:5174). Unset = no link.
# VITE_DASHBOARD_URL=http://localhost:5174
# Hosted agent server for the Connect an agent dialog, e.g.
# https://mcp.example.com/mcp. Unset = no Connect openers.
# VITE_MCP_URL=
# Hosted privacy policy, linked from the code panel and the Connect dialog.
# Unset = no link (self-hosted builds).
# VITE_PRIVACY_URL=
