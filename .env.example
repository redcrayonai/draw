# Settings for compose.prod.yml. Copy to .env next to it and fill in every
# empty value; never commit .env. The stack refuses to start with a secret left
# empty or at an example value.

# The canvas is served at https://DOMAIN, the dashboard at https://dash.DOMAIN
# and the agent server at https://mcp.DOMAIN. Point all three at this machine
# and open ports 80 and 443; Caddy gets the certificates.
DOMAIN=

# The image version to run: a release tag without the leading v, e.g. 0.1.0.
REDCRAYON_VERSION=

# Sign-in. anonymous: no accounts, everyone is a guest. oidc: your OpenID
# Connect provider, with a public client (PKCE, no secret) whose redirect URIs
# are https://DOMAIN/ and https://dash.DOMAIN/.
VITE_AUTH_PROVIDER=anonymous
# oidc only: the issuer exactly as its tokens' iss, and the client id (the
# module also accepts it as a token's azp or aud).
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
# 1 = every page asks for sign-in first (oidc only; anonymous refuses to start).
VITE_REQUIRE_AUTH=
# anonymous only. 1 = anyone who reaches the dashboard may import public GitHub
# repositories, which runs git and go on this machine. Empty = imports need oidc.
IMPORTS_ANONYMOUS=

# Storage limits. on caps what one call, board or guest can keep: repo files per
# board, node doc size, boards per owner, branches per board and waiting mark
# seats (module/src/limits.ts), and the repository size imports fetch
# (IMPORT_MAX_REPO_MB). Empty or off = none of these. They also refuse writes to
# data stored before them, so check your largest boards first. Read when the
# module is published, so restart module-setup after a change.
REDCRAYON_LIMITS=
# With limits on: the largest public repository an import fetches, in MB
# (GitHub's size; default 500, 0 = none).
IMPORT_MAX_REPO_MB=
# The importer's scratch disk and memory always apply, whatever REDCRAYON_LIMITS
# says. /tmp is a tmpfs, so its size counts toward the memory limit: keep the
# memory limit a few GB above it (defaults 2g and 6g).
IMPORTER_TMP_SIZE=
IMPORTER_MEM_LIMIT=

# Agent keys, comma-separated <sha256 hex of the key>:<user id>. Make one with:
#   key="$(openssl rand -hex 32)"; printf '%s:%s\n' "$(printf %s "$key" | sha256sum | cut -d' ' -f1)" <user id>
# and give the agent "$key" as its bearer token.
# oidc: the user id is the person's sub at VITE_OIDC_ISSUER, whose boards the
# agent draws on. Empty = agents sign in through VITE_OIDC_ISSUER instead.
# anonymous: agents need a key (there is no sign-in), and any user id works.
# The person gives the agent a board's edit link (Share, Share with link, Can edit).
# Point the plugin at this server with REDCRAYON_MCP_URL=https://mcp.DOMAIN/mcp.
MCP_API_KEYS=

# Versions plugin (optional): saved versions of boards, kept in an S3-compatible
# bucket you run or rent. Set the endpoint, bucket and region to offer it;
# workspace owners and admins then turn it on under Settings, Plugins. Use an
# empty bucket only this deployment writes. Its endpoint must be reachable from
# the dashboard container: a public address, or a service on this stack's
# network (not localhost). Path-style requests: <endpoint>/<bucket>/<key>.
# Credentials: set both keys (read and write on the bucket), or leave both empty
# to use the machine's role: an EC2 instance profile (IMDSv2; set the instance's
# metadata hop limit to 2 so containers reach it) or an ECS task role. The
# dashboard keeps them; browsers never see them.
VERSIONS_S3_ENDPOINT=
VERSIONS_S3_BUCKET=
VERSIONS_S3_REGION=
VERSIONS_S3_ACCESS_KEY_ID=
VERSIONS_S3_SECRET_ACCESS_KEY=

# Secrets. Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
IMPORT_RUNNER_SECRET=

# Caddy global options. Empty for a public domain. local_certs gives a test
# machine without one certificates from Caddy's own CA (browsers warn).
CADDY_GLOBAL_OPTIONS=
